# ============================================================
# UPENDRA GENERAL STORES - BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# Django Core Configuration
SECRET_KEY=django-insecure-upendra-store-production-key-change-this
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (Neon PostgreSQL in Production / SQLite in Development)
DATABASE_URL=
# Alternatively, specify individual DB parameters:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
USE_POSTGRES=False
USE_MYSQL=False

# ============================================================
# REAL SMS PROVIDER CONFIGURATION (INDIA)
# Set SMS_PROVIDER to one of: fast2sms, msg91, 2factor, twilio, custom
# ============================================================
SMS_PROVIDER=fast2sms

# 1. Fast2SMS (Recommended for India Quick OTP SMS)
# Get API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=
# Optional DLT parameters for Fast2SMS:
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# 2. MSG91 (https://msg91.com/)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# 3. 2Factor (https://2factor.in/)
TWOFACTOR_API_KEY=

# 4. Twilio (https://www.twilio.com/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 5. Generic / Custom Gateway Webhook URL (supports {MOBILE} and {OTP} placeholders)
SMS_GATEWAY_URL=

# ============================================================
# ADMINISTRATOR ACCOUNT CREDENTIALS
# ============================================================
ADMIN_EMAIL=upendrageneralstore@gmail.com
ADMIN_MOBILE=7050830610
ADMIN_PASSWORD=

# ============================================================
# PAYMENT GATEWAY (Razorpay / UPI)
# ============================================================
PAYMENT_GATEWAY=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
