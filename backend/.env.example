# ============================================================
# UPENDRA GENERAL STORES - BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# Django Core
DJANGO_SECRET_KEY=change-in-production-use-a-strong-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Configuration
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local SQLite default: Leave DATABASE_URL empty
DATABASE_URL=

# Local MySQL (Optional, when DATABASE_URL is empty):
USE_MYSQL=False
DB_NAME=upendra_store_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# CORS - Allowed Frontend Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-app.vercel.app

# Administrator Credentials (Used by seed_data command)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_MOBILE=9876543210
ADMIN_PASSWORD=your_secure_admin_password

# Payment Gateway (Razorpay / Sandbox)
PAYMENT_GATEWAY=razorpay
PAYMENT_KEY_ID=rzp_test_51b9eM8Lz5jM4h
PAYMENT_KEY_SECRET=your_razorpay_secret_here
PAYMENT_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

